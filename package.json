{
  "name": "olt-manager",
  "version": "1.1.8",
  "description": "Read-only GPON OLT management and ONU ledger desktop/web tool.",
  "author": "landvd",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "olt-manager": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "cli": "node src/cli.mjs",
    "desktop": "electron .",
    "dev": "vite --host 127.0.0.1",
    "check:version": "node scripts/check-version.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test": "pnpm run check:version && node --test tests/*.test.mjs",
    "seed:sample": "node scripts/export-seed-sample.mjs",
    "reset:data": "node scripts/reset-data.mjs --yes",
    "prepare:win-sqlite": "node scripts/prepare-win-sqlite.mjs",
    "prepare:feishu-runtime": "node scripts/prepare-feishu-runtime.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dist:mac": "pnpm build && pnpm run prepare:feishu-runtime && electron-builder --mac dmg --arm64 --publish never",
    "dist:win": "pnpm build && pnpm run prepare:feishu-runtime && pnpm run prepare:win-sqlite && electron-builder --win zip --x64 --publish never",
    "dist:win:zip": "pnpm build && pnpm run prepare:feishu-runtime && pnpm run prepare:win-sqlite && electron-builder --win zip --x64 --publish never",
    "dist:dir": "pnpm build && pnpm run prepare:feishu-runtime && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@larksuiteoapi/node-sdk": "1.71.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "balanced-match": "4.0.2",
    "brace-expansion": "5.0.12",
    "element-plus": "^2.11.8",
    "minimatch": "10.2.5",
    "vue": "^3.5.24",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.landvd.olt-manager",
    "productName": "OLT Manager",
    "asar": false,
    "npmRebuild": false,
    "disableDefaultIgnoredFiles": true,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "electron/**/*",
      "assets/**/*",
      "build/feishu-runtime/**/*",
      "bin/win32/**/*",
      "data/*.example.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/win32",
        "to": "bin/win32",
        "filter": [
          "sqlite3.exe",
          "README.md"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "${productName}-${version}-arm64.${ext}"
    },
    "win": {
      "icon": "assets/generated/olt-manager.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win11-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
